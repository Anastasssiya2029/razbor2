{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p02-transition-strategist.output.v1.3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "promptVersion",
    "schemaVersion",
    "analysisStatus",
    "constraint",
    "perceivedVsEvidenced",
    "previousAttemptsAnalysis",
    "candidateAudit",
    "bundle",
    "elementSequence",
    "businessValidation",
    "sanityChecks"
  ],
  "properties": {
    "promptVersion": {
      "const": "P-02.v1.3"
    },
    "schemaVersion": {
      "const": "1.3"
    },
    "analysisStatus": {
      "enum": [
        "ok",
        "low_confidence",
        "blocked_by_inconsistency"
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symptom",
        "functional_bottleneck",
        "constraint_stage",
        "constraint_type",
        "root_cause",
        "root_evidence_ids",
        "counterevidence_ids",
        "confidence",
        "missing_evidence"
      ],
      "properties": {
        "symptom": {
          "type": "string",
          "maxLength": 600
        },
        "functional_bottleneck": {
          "type": "string",
          "maxLength": 800
        },
        "constraint_stage": {
          "enum": [
            "opportunities",
            "interest",
            "next_step",
            "offer",
            "payment",
            "continuation",
            "referral",
            "capacity",
            "system_repeatability",
            "model_fit"
          ]
        },
        "constraint_type": {
          "enum": [
            "demand_shortage",
            "path_break",
            "low_monetization",
            "weak_product_economics",
            "low_retention",
            "owner_capacity",
            "founder_model_misfit",
            "fragmented_system",
            "owner_dependency"
          ]
        },
        "root_cause": {
          "type": "string",
          "maxLength": 900
        },
        "root_evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "counterevidence_ids": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "missing_evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidateAudit": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id",
          "hypothesis",
          "supporting_evidence_ids",
          "counterevidence_ids",
          "dependency_position",
          "target_necessity",
          "decision",
          "rejection_reason",
          "tie_break_step"
        ],
        "properties": {
          "element_id": {
            "enum": [
              "authenticity",
              "audience",
              "product_method",
              "sales_technology",
              "funnel",
              "blog",
              "team"
            ]
          },
          "hypothesis": {
            "type": "string",
            "maxLength": 700
          },
          "supporting_evidence_ids": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "counterevidence_ids": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "dependency_position": {
            "type": "string",
            "maxLength": 500
          },
          "target_necessity": {
            "type": "string",
            "maxLength": 500
          },
          "decision": {
            "enum": [
              "selected",
              "rejected"
            ]
          },
          "rejection_reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 600
          },
          "tie_break_step": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 7
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority_element",
        "build_elements",
        "maintain_elements",
        "later_elements",
        "why_this_bundle",
        "why_not_now"
      ],
      "properties": {
        "priority_element": {
          "enum": [
            "authenticity",
            "audience",
            "product_method",
            "sales_technology",
            "funnel",
            "blog",
            "team",
            null
          ]
        },
        "build_elements": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "authenticity",
              "audience",
              "product_method",
              "sales_technology",
              "funnel",
              "blog",
              "team"
            ]
          }
        },
        "maintain_elements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "authenticity",
              "audience",
              "product_method",
              "sales_technology",
              "funnel",
              "blog",
              "team"
            ]
          }
        },
        "later_elements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element_id",
              "reason",
              "return_trigger"
            ],
            "properties": {
              "element_id": {
                "enum": [
                  "authenticity",
                  "audience",
                  "product_method",
                  "sales_technology",
                  "funnel",
                  "blog",
                  "team"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 700
              },
              "return_trigger": {
                "type": "string",
                "maxLength": 700
              }
            }
          }
        },
        "why_this_bundle": {
          "type": "string",
          "maxLength": 1400
        },
        "why_not_now": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element_id",
              "reason_code",
              "reason",
              "return_trigger"
            ],
            "properties": {
              "element_id": {
                "enum": [
                  "authenticity",
                  "audience",
                  "product_method",
                  "sales_technology",
                  "funnel",
                  "blog",
                  "team"
                ]
              },
              "reason_code": {
                "enum": [
                  "TARGET_ALREADY_SUFFICIENT",
                  "NO_CAUSAL_LINK",
                  "PREMATURE",
                  "WORKING_ALTERNATIVE",
                  "CAPACITY_FIRST",
                  "NEEDS_PRIOR_VALIDATION"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 700
              },
              "return_trigger": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 700
              }
            }
          }
        }
      }
    },
    "elementSequence": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "element_id",
          "role",
          "from_score",
          "to_score",
          "why_now",
          "prerequisite_elements",
          "unlocks",
          "evidence_ids"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "element_id": {
            "enum": [
              "authenticity",
              "audience",
              "product_method",
              "sales_technology",
              "funnel",
              "blog",
              "team"
            ]
          },
          "role": {
            "enum": [
              "priority",
              "build"
            ]
          },
          "from_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "to_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "why_now": {
            "type": "string",
            "maxLength": 800
          },
          "prerequisite_elements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "authenticity",
                "audience",
                "product_method",
                "sales_technology",
                "funnel",
                "blog",
                "team"
              ]
            }
          },
          "unlocks": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "businessValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_after_order",
        "metric_name",
        "baseline_value",
        "target_value",
        "unit",
        "target_rule",
        "formula",
        "assumptions",
        "timeframe_days",
        "if_signal_absent",
        "evidence_ids"
      ],
      "properties": {
        "checkpoint_after_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "metric_name": {
          "type": "string",
          "maxLength": 300
        },
        "baseline_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "target_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_rule": {
          "type": "string",
          "maxLength": 700
        },
        "formula": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 700
        },
        "assumptions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "timeframe_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 90
        },
        "if_signal_absent": {
          "type": "string",
          "maxLength": 700
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sanityChecks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "element_ids",
          "evidence_ids"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 800
          },
          "element_ids": {
            "type": "array",
            "items": {
              "enum": [
                "authenticity",
                "audience",
                "product_method",
                "sales_technology",
                "funnel",
                "blog",
                "team"
              ]
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "perceivedVsEvidenced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_hypothesis",
        "evidenced_bottleneck",
        "relation",
        "explanation",
        "evidence_ids"
      ],
      "properties": {
        "client_hypothesis": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 900
        },
        "evidenced_bottleneck": {
          "type": "string",
          "maxLength": 900
        },
        "relation": {
          "enum": [
            "matches",
            "partially_matches",
            "differs",
            "insufficient_data"
          ]
        },
        "explanation": {
          "type": "string",
          "maxLength": 1100
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "previousAttemptsAnalysis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempts_summary",
            "repeated_break_pattern",
            "why_not_stable",
            "route_difference",
            "confidence",
            "evidence_ids"
          ],
          "properties": {
            "attempts_summary": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "maxLength": 600
              }
            },
            "repeated_break_pattern": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 900
            },
            "why_not_stable": {
              "type": "string",
              "maxLength": 1200
            },
            "route_difference": {
              "type": "string",
              "maxLength": 1200
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "title": "P02TransitionStrategistOutputV1_3"
}
