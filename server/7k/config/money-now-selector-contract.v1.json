  "capacityFitRules": {
    "requires_additional_delivery": [
      {
        "when": {
          "CURRENT_OVERLOAD": "confirmed_true"
        },
        "result": "no_fit"
      },
      {
        "when": {
          "HAS_UNUSED_CAPACITY": "confirmed_true"
        },
        "result": "fit"
      },
      {
        "when": {
          "HAS_UNUSED_CAPACITY": "confirmed_false"
        },
        "result": "no_fit"
      },
      {
        "otherwise": true,
        "result": "risk"
      }
    ],
    "uses_existing_flow": [
      {
        "when": {
          "CURRENT_OVERLOAD": "confirmed_true"
        },
        "result": "risk"
      },
      {
        "otherwise": true,
        "result": "fit"
      }
    ],
    "capacity_neutral": [
      {
        "otherwise": true,
        "result": "fit"
      }
    ]
  },
